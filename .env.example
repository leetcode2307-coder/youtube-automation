# ==========================================
# AI Engineering YouTube Shorts Automation
# Environment Configuration (.env)
# ==========================================

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Scheduler Settings (Asia/Kolkata)
TIMEZONE=Asia/Kolkata
MORNING_CRON=0 7 * * *
EVENING_CRON=30 16 * * *
# Set to true when running as a single web service (e.g., on Render)
ENABLE_EMBEDDED_SCHEDULER=false

# Storage Directories
DATA_DIR=data
PACKAGES_DIR=data/packages
FLOW_EXPORTS_DIR=data/flow_exports
FINAL_OUTPUT_DIR=data/final
TOPIC_HISTORY_FILE=data/topic_history.json
UPLOAD_LEDGER_FILE=data/upload_ledger.json
APPROVALS_FILE=data/approvals.json

# Approval Service & Security
APPROVAL_SECRET_KEY=change_this_to_a_random_32_byte_string_for_signing
APPROVAL_BASE_URL=http://127.0.0.1:8000
APPROVAL_TOKEN_EXPIRE_HOURS=24
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
APPROVAL_RECIPIENT_EMAIL=your_email@gmail.com
SENDER_EMAIL=your_email@gmail.com

# YouTube Data API v3 (OAuth 2.0)
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# Optional for cloud/Render: paste raw JSON contents directly in env vars
# YOUTUBE_CLIENT_SECRET_JSON=
# YOUTUBE_TOKEN_JSON=
DEFAULT_PRIVACY_STATUS=private

# Voiceover TTS & FFmpeg Settings
TTS_VOICE=en-US-ChristopherNeural
FFMPEG_THREADS=2
